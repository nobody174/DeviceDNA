<Project Sdk="WixToolset.Sdk/6.0.1">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>DeviceDNA-Setup</OutputName>
    <Platform>x64</Platform>
    <DefineConstants>PublishDir=$(PublishDir);IconFile=$(IconFile)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.1" />
  </ItemGroup>

</Project>
