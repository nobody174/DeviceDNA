<UserControl x:Class="DeviceDNA.UI.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:presentation="clr-namespace:DeviceDNA.UI.Presentation"
             mc:Ignorable="d">

    <!-- History & Changes page (REQUIREMENTS.md section 7 items 4-5), converted from a separate
         popup Window to in-place navigation — same pattern as DiagnoseView, user feedback
         (2026-08-16): "I want that to swap windows inside the main app as well as we did with the
         diagnose popup." DataContext is MainViewModel; HistoryViewModel.History/.Changes are bound
         through it. -->
    <UserControl.Resources>
        <DataTemplate x:Key="ScanRowTemplate" DataType="{x:Type presentation:ScanHistoryRowViewModel}">
            <Border Background="{StaticResource TileBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,6"
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,12,0"
                              Fill="{Binding StatusBrushKey, Converter={StaticResource HealthStatusToBrushConverter}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Hostname}" VerticalAlignment="Center" FontSize="13"/>
                    <TextBlock Grid.Column="2" Text="{Binding TimestampLabel}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ChangeRowTemplate" DataType="{x:Type presentation:ChangeRowViewModel}">
            <Border Background="{StaticResource TileBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,6"
                    Padding="12">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="{Binding DnaTypeLabel, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding DnaName, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Description}" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>

        <!-- Sub-header: back navigation + title. The app-level top bar (logo, Rescan/History/
             Diagnose/Export) stays visible above this via MainWindow — only the main content area
             swaps, same as DiagnoseView. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource TopBarBrush}" Padding="20,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="← Back to Dashboard"
                        Command="{Binding GoBackToDashboardCommand}" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="1" Text="History &amp; Changes" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- History column -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Scan History" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource GoldBrush}" Margin="0,0,0,10"/>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding HistoryViewModel.History.FilterOptions}"
                              SelectedItem="{Binding HistoryViewModel.History.SelectedFilter, Mode=TwoWay}"
                              DisplayMemberPath="Label" Padding="6,4"/>
                    <Button Grid.Column="1" Content="Refresh" Command="{Binding HistoryViewModel.History.RefreshCommand}"
                            Margin="8,0,0,0" Padding="10,4" FontSize="12"/>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="{Binding HistoryViewModel.History.SummaryText}" Margin="0,0,0,10"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding HistoryViewModel.History.Scans}" ItemTemplate="{StaticResource ScanRowTemplate}"/>
                </ScrollViewer>
            </DockPanel>

            <!-- Changes column -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="What Changed" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource GoldBrush}" Margin="0,0,0,10"/>

                <!-- Arbitrary scan-pair picker: defaults to the two most recent scans (the common
                     "what changed since last time" case), but either dropdown can be changed to
                     compare any two scans in local history. -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="From" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding HistoryViewModel.Changes.ScanOptions}"
                                  SelectedItem="{Binding HistoryViewModel.Changes.FromScan, Mode=TwoWay}"
                                  DisplayMemberPath="Label" Padding="6,4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="To" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding HistoryViewModel.Changes.ScanOptions}"
                                  SelectedItem="{Binding HistoryViewModel.Changes.ToScan, Mode=TwoWay}"
                                  DisplayMemberPath="Label" Padding="6,4"/>
                    </StackPanel>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="{Binding HistoryViewModel.Changes.ComparisonLabel}" Margin="0,0,0,4"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding HistoryViewModel.Changes.SummaryText}" Margin="0,0,0,10"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding HistoryViewModel.Changes.Changes}" ItemTemplate="{StaticResource ChangeRowTemplate}"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
