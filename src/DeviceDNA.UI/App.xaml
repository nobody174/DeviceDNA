<Application x:Class="DeviceDNA.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeviceDNA.UI"
             xmlns:presentation="clr-namespace:DeviceDNA.UI.Presentation"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Command-deck dark theme: deep charcoal base, white + gold chrome accents,
                 green/yellow/red reserved strictly for health status (REQUIREMENTS.md section 9). -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#FF14161A"/>
            <SolidColorBrush x:Key="TopBarBrush" Color="#FF1B1E24"/>
            <SolidColorBrush x:Key="TileBackgroundBrush" Color="#FF20232A"/>
            <SolidColorBrush x:Key="TileBackgroundHoverBrush" Color="#FF272B33"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#FF32363F"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF2F2F2"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA0A5AD"/>
            <SolidColorBrush x:Key="GoldBrush" Color="#FFD4AF5A"/>
            <!-- Second orbital-strand accent (paired with GoldBrush), a desaturated teal echoing
                 Logo.png's rainbow-gradient helix in a restrained two-tone form appropriate for a
                 UI. Used only for the orbital dashboard's node-to-hub connector lines — never as a
                 status color (see REQUIREMENTS.md section 9: green/yellow/red are reserved). -->
            <SolidColorBrush x:Key="StrandAccentBrush" Color="#FF5CA8B8"/>

            <!-- Real, recognizable per-DNA-type icons for the orbital dashboard nodes (user
                 feedback, 2026-08-16: "wifi icon for network, gpu card drawing, cpu block with pins,
                 old-style harddrive for storage, motherboard with real layout not just a square,
                 windows logo for OS, two ram sticks side by side for memory"). Path data ported from
                 the approved HTML mockup's inline SVG (24x24 viewBox), converting each SVG
                 rect/circle primitive to explicit WPF Path mini-language commands — WPF's Path.Data
                 has no <rect>/<circle> element, only M/L/H/V/C/Q/A/Z path commands. Stroke-based
                 icons render via a Style below (Stroke bound, Fill=Transparent); the OS icon is
                 fill-based (solid Windows-logo quadrants) and rendered with Fill instead. -->
            <Geometry x:Key="IconGeometry.Cpu">M7,7 L17,7 17,17 7,17 Z M10,10 L14,10 14,14 10,14 Z M9,2 L9,5 M12,2 L12,5 M15,2 L15,5 M9,19 L9,22 M12,19 L12,22 M15,19 L15,22 M2,9 L5,9 M2,12 L5,12 M2,15 L5,15 M19,9 L22,9 M19,12 L22,12 M19,15 L22,15</Geometry>
            <Geometry x:Key="IconGeometry.Gpu">M2,6 A1.5,1.5 0 0 1 3.5,4.5 L20.5,4.5 A1.5,1.5 0 0 1 22,6 L22,15 A1.5,1.5 0 0 1 20.5,16.5 L3.5,16.5 A1.5,1.5 0 0 1 2,15 Z M4.6,11.5 A2.4,2.4 0 1 0 9.4,11.5 A2.4,2.4 0 1 0 4.6,11.5 Z M10.6,11.5 A2.4,2.4 0 1 0 15.4,11.5 A2.4,2.4 0 1 0 10.6,11.5 Z M18,9 L18,14 M2,17 L2,19 A1,1 0 0 0 3,20 L5,20 M22,6 L22,4 A1,1 0 0 0 21,3 L18,3</Geometry>
            <Geometry x:Key="IconGeometry.Memory">M2.5,5 A1,1 0 0 1 3.5,4 L9,4 A1,1 0 0 1 10,5 L10,19 A1,1 0 0 1 9,20 L3.5,20 A1,1 0 0 1 2.5,19 Z M14,5 A1,1 0 0 1 15,4 L20.5,4 A1,1 0 0 1 21.5,5 L21.5,19 A1,1 0 0 1 20.5,20 L15,20 A1,1 0 0 1 14,19 Z M4.5,4 L4.5,7 M6.5,4 L6.5,7 M8.5,4 L8.5,7 M16,4 L16,7 M18,4 L18,7 M20,4 L20,7</Geometry>
            <!-- Redesigned after user feedback that the first conversion (a straight SVG port) read
                 weakly at small size — a classic HDD silhouette: rectangular case, a visible circular
                 platter with hub, and a diagonal read/write arm reaching to the platter's edge. -->
            <Geometry x:Key="IconGeometry.Storage">M2,4.5 A1.5,1.5 0 0 1 3.5,3 L20.5,3 A1.5,1.5 0 0 1 22,4.5 L22,19.5 A1.5,1.5 0 0 1 20.5,21 L3.5,21 A1.5,1.5 0 0 1 2,19.5 Z M6.2,12 A5.8,5.8 0 1 0 17.8,12 A5.8,5.8 0 1 0 6.2,12 Z M12,10.4 A1.6,1.6 0 1 0 12,13.6 A1.6,1.6 0 1 0 12,10.4 Z M18.5,6.3 L13.1,10.9</Geometry>
            <Geometry x:Key="IconGeometry.Motherboard">M2.5,4 A1.5,1.5 0 0 1 4,2.5 L20,2.5 A1.5,1.5 0 0 1 21.5,4 L21.5,20 A1.5,1.5 0 0 1 20,21.5 L4,21.5 A1.5,1.5 0 0 1 2.5,20 Z M5,5 L11,5 11,11 5,11 Z M14,5 L19,5 19,8 14,8 Z M14,10.5 L19,10.5 M5,13.5 L9,13.5 M11.5,13.5 L11.5,19.5 M5,17 L9,17 M16.5,13 L16.5,19.5 M19,15.5 L14,15.5</Geometry>
            <Geometry x:Key="IconGeometry.Network">M4,9.5 A12,12 0 0 1 20,9.5 M7,13 A7.5,7.5 0 0 1 17,13 M10,16.5 A3,3 0 0 1 14,16.5</Geometry>
            <Geometry x:Key="IconGeometry.Os">M3,5.6 L10.4,4.6 10.4,11.7 3,11.7 Z M11.3,4.5 L21,3.2 21,11.6 11.3,11.6 Z M3,12.6 L10.4,12.6 10.4,19.7 3,18.7 Z M11.3,12.6 L21,12.6 21,21 11.3,19.7 Z</Geometry>

            <SolidColorBrush x:Key="StatusGreenBrush" Color="#FF3FB86F"/>
            <SolidColorBrush x:Key="StatusYellowBrush" Color="#FFE0B93C"/>
            <SolidColorBrush x:Key="StatusRedBrush" Color="#FFE05C4C"/>

            <presentation:HealthStatusToBrushConverter x:Key="HealthStatusToBrushConverter"/>
            <presentation:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <presentation:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <presentation:BoolToCursorConverter x:Key="BoolToCursorConverter"/>
            <presentation:CheckingLabelConverter x:Key="CheckingLabelConverter"/>
            <presentation:RescanLabelConverter x:Key="RescanLabelConverter"/>
            <presentation:DnaTypeToIconGeometryConverter x:Key="DnaTypeToIconGeometryConverter"/>
            <presentation:DnaTypeIsOsConverter x:Key="DnaTypeIsOsConverter"/>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <!-- Hover indicator color: a red frame instead of WPF's default light-blue/white
                 highlight (user feedback, 2026-08-16: "I rather have it just to visual show it with
                 a darker frame... make the button we're hovering over get a red frame instead").
                 Kept as its own brush (not StatusRedBrush reused directly) so hover color can be
                 tuned independently of the red health-status meaning if that's ever needed. -->
            <SolidColorBrush x:Key="HoverFrameBrush" Color="#FFE05C4C"/>

            <!-- Themed Button: gold border always visible (fixes Export/Rescan previously having no
                 visible frame at all — an inconsistency in the original per-button inline styling,
                 not intentional), red border on hover, and an explicit disabled-state Foreground so
                 the Rescan button's label stays legible while scanning instead of washing out to
                 WPF's default low-contrast disabled text (user feedback: "the rescan button just
                 turns white when clicked, it should also say scanning"). -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource TileBackgroundHoverBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Explicit IsEnabled=True restore alongside the False case, and
                                     IsEnabled checked ahead of IsMouseOver in trigger order — a
                                     button intermittently losing its gold frame after navigating
                                     between views (user feedback, 2026-08-16) traced to WPF trigger
                                     evaluation order/property-value-precedence, not a Visibility
                                     desync (ruled out: it happens on the always-visible top-bar
                                     buttons, not ones inside a swapped page). Giving every state an
                                     explicit setter removes the ambiguity that let a stale value
                                     persist. -->
                                <Trigger Property="IsEnabled" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource HoverFrameBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource BorderBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Themed ToggleButton: replaces WPF's default system-accent-blue checked-state
                 highlight (which clashed with the dark/gold theme and looked "stuck" — user
                 feedback) with the same neutral tile-hover background used elsewhere, regardless
                 of checked state. Only the border picks up gold when checked, as a subtle
                 "currently showing Advanced" indicator rather than a jarring color swap. -->
            <Style TargetType="ToggleButton">
                <Setter Property="Background" Value="{StaticResource TileBackgroundHoverBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Themed ComboBox: fixes History's "From"/"To" and filter dropdowns rendering with
                 WPF's default light theme (white background, near-white text against this app's
                 dark window — "almost unreadable," user feedback, 2026-08-16). Dark background,
                 primary-text foreground, gold-on-hover popup items. -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="{StaticResource TileBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Padding" Value="8,5"/>
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{StaticResource TileBackgroundHoverBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource TileBackgroundHoverBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                                   Content="{TemplateBinding SelectionBoxItem}"
                                                   ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                   Margin="8,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Path Data="M0,0 L4,4 L8,0 Z" Fill="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                      IsHitTestVisible="False"/>
                                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Border Background="{StaticResource TileBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
